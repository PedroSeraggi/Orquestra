# Copie para .env e preencha. Tudo é opcional: sem chaves, a Orquestra funciona, só não melhora o pedido
# (fonte "Zera") nem gera as lições do juiz.

# Gemini (grátis em https://aistudio.google.com/apikey): melhora o pedido e resume as lições
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Groq (grátis em https://console.groq.com/keys): reserva quando o Gemini falha
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Pasta onde ficam fluxos, trabalhos e lições (padrão: ~/Orquestra)
ORQUESTRA_DIR=

# Caminho do Claude Code, se não estiver no PATH
CLAUDE_BIN=
